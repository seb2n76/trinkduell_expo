# Copy this file to "server/.env" and fill in real values.
# server/.env is gitignored and must never be committed.

# Postgres credentials used by docker-compose.yml (db + backend services)
POSTGRES_USER=trinkduell_user
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=trinkduell

# Secret used to sign JWT session tokens. Generate a long random value, e.g.:
#   openssl rand -hex 32
# REQUIRED as soon as DATABASE_URL is set: the server refuses to start with the
# built-in development key (it is in the public repo) or with fewer than 32
# characters.
JWT_SECRET=change-me-to-a-long-random-secret

# Optional: comma-separated list of browser origins allowed to call the API.
# Unset means the defaults in server/index.js (webapp.trinkduell.com plus the
# local Expo dev ports). Native app requests send no Origin and are unaffected.
# ALLOWED_ORIGINS=https://webapp.trinkduell.com,https://staging.trinkduell.com

# Optional: real password-reset emails via Resend (see docs/EMAIL_SETUP.md).
# Leave unset to keep the current beta behavior (reset code shown in-app).
# RESEND_API_KEY=re_your_real_key
# RESEND_FROM_EMAIL=TrinkDuell <noreply@trinkduell.com>
